# ==========================================================================
# Loris .gitignore
# The repository is source-only. The CMake build works out-of-tree in
# build/, so generated files no longer land in the source tree at all.
# ==========================================================================

# --- CMake build trees ---
/build/
/build-*/

# --- Compiled objects and libraries (e.g. from the static demo/Makefile) ---
*.o
*.a
*.so
*.dylib
*.dSYM/

# --- Python bytecode ---
__pycache__/
*.pyc
*.pyo

# --- Python virtual environment ---
/.venv/
/venv/

# --- Scratch files from manually-run test programs ---
*.ctest.*
*.pytest.*
*.pi.*

# --- Xcode ---
xcode/build/
xcode/DerivedData/
*.xcuserstate
**/xcuserdata/
**/xcshareddata/IDEWorkspaceChecks.plist
# Legacy per-user Xcode files (currently committed relics; safe to `git rm --cached` later)
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# --- macOS / editor cruft ---
.DS_Store
*~
*.swp

# --- Claude Code (keep shared settings.json tracked; ignore personal + local) ---
.claude/settings.local.json

# --- Local-only working notes (not for the repo, for now) ---
/PROJECT-STATUS.md
