# ==========================================================================
# Loris .gitignore
# The repository is source-only: everything generated by autotools, libtool,
# SWIG, the compiler, Doxygen, Xcode, or the test suite is ignored below.
# ==========================================================================

# --- Autotools / configure output (root) ---
/configure
/config.status
/config.log
/config.h
/config.h.in
/config.h.in~
/stamp-h1
/aclocal.m4
/autom4te.cache/
/libtool
# AC_CONFIG_AUX_DIR: install-sh, missing, depcomp, ltmain.sh, config.guess/sub, compile, test-driver
/config/

# --- Generated Makefiles (root + configured SUBDIRS only; demo/Makefile is a tracked static file) ---
/Makefile
/csound/Makefile
/doc/Makefile
/scripting/Makefile
/src/Makefile
/test/Makefile
/utils/Makefile
Makefile.in

# --- Files generated from *.in by config.status ---
# /src/loris.h from src/loris.h.in ; /doc/Doxyfile from doc/Doxyfile.in
/src/loris.h
/doc/Doxyfile

# --- libtool / make build trees ---
.libs/
.deps/
.dirstamp

# --- Compiled objects, libraries, executables ---
*.o
*.lo
*.la
*.a
*.so
*.dylib
*.slo
*.Plo
*.Tpo
*.dSYM/

# --- SWIG / Python generated (scripting/lorisdoc.py is a tracked source file) ---
/scripting/loris.py
/scripting/loris_python_wrap.C
__pycache__/
*.pyc
*.pyo

# --- Doxygen output ---
/doc/html/
/doc/latex/

# --- Built test executables (sources are test_*.C; these lowercase binaries are generated) ---
/test/test_aiff
/test/test_cpp
/test/test_crop
/test/test_distiller
/test/test_filter
/test/test_fundamental
/test/test_identity
/test/test_morpher
/test/test_partial
/test/test_pi
/test/test_resample
/test/test_sdiffile
/test/test_synthesizer

# --- Built CLI utilities (sources are utils/loris_*.C; these loris-* binaries are generated) ---
/utils/loris-*

# --- Test-suite artifacts (see test/Makefile.am CLEANFILES) ---
*.ctest.*
*.pytest.*
*.pi.*
/test/run_pytest
/test/tmp.sdif
/test/csound_opcode_test.aiff
/test/flutefundamental.aiff
*.log
*.trs
test-suite.log

# --- Xcode ---
xcode/build/
xcode/DerivedData/
*.xcuserstate
**/xcuserdata/
**/xcshareddata/IDEWorkspaceChecks.plist
# Legacy per-user Xcode files (currently committed relics; safe to `git rm --cached` later)
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# --- macOS / editor cruft ---
.DS_Store
*~
*.swp

# --- Python virtual environment ---
/.venv/
/venv/

# --- Claude Code (keep shared settings.json tracked; ignore personal + local) ---
.claude/settings.local.json

# --- Local-only working notes (not for the repo, for now) ---
/PROJECT-STATUS.md
